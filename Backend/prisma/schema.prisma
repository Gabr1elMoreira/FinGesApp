generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  password          String
  name              String
  avatar            String?
  role              Role            @default(USER)
  lastLoginAt       DateTime?
  theme             String          @default("dark")
  enabledCategories String[]
  preferences       Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  monthlyReports    MonthlyReport[]
  transactions      Transaction[]
  goals             Goal[]
  accounts          Account[]
  budgets           Budget[]
}

model Account {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  type          String        @default("CHECKING") // CHECKING, SAVINGS, WALLET, CREDIT_CARD, INVESTMENT
  initialBalance Float        @default(0)
  color         String?
  archived      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]

  @@index([userId])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  amount    Float
  month     Int // 0-11
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, month, year])
  @@index([userId, year, month])
}

model Goal {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  description   String
  targetAmount  Float
  currentAmount Float          @default(0)
  type          String // SPENDING_LIMIT | SAVINGS_TARGET
  category      String?
  deadline      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contributions Contribution[]

  @@index([userId])
}

model Contribution {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([goalId])
}

model Transaction {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  accountId           String?
  account             Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transferId          String? // agrupa o par origem/destino de uma transferência
  description         String
  amount              Float
  type                String // INCOME, EXPENSE, TRANSFER
  category            String
  paymentMethod       String
  date                DateTime
  isPaid              Boolean  @default(true) // NOVO CAMPO: Define se a conta foi paga
  isRecurrent         Boolean  @default(false)
  recurrenceFrequency String   @default("NONE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([accountId])
}

enum ReportVerdict {
  EXCELLENT
  STABLE
  CRITICAL
}

model MonthlyReport {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  month     Int
  year      Int
  verdict   ReportVerdict
  summary   String        @db.Text
  insights  Json // Lista de insights [string]
  tip       String        @db.Text
  createdAt DateTime      @default(now())

  @@unique([userId, month, year])
}

model SystemBroadcast {
  id        String   @id @default(uuid())
  title     String
  message   String   @db.Text
  type      String   @default("broadcast")
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model AuditLog {
  id        String   @id @default(uuid())
  message   String
  type      String   @default("info")
  createdAt DateTime @default(now())
}

